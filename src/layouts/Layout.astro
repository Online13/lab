---
import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';
import Icon from '../components/Icon.astro';

interface Props { title?: string; description?: string }
const { title, description = 'Mon laboratoire : je teste et j’apprends des notions par le code, puis je les partage.' } = Astro.props;
---
<!doctype html>
<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
		<title>{title ? `${title} · Lab` : 'Lab'}</title>
	</head>
	<body>
		<div class="app">
			<Sidebar />
			<div class="main">
				<header class="topbar">
					<button class="menu" type="button" aria-label="Ouvrir le menu" aria-controls="sidebar" aria-expanded="false"><Icon name="menu" size={18} /></button>
					<slot name="topbar" />
				</header>
				<main><slot /></main>
			</div>
		</div>
		<div class="scrim" aria-hidden="true"></div>
		<script>
			const button = document.querySelector<HTMLButtonElement>('.menu')!;
			const toggle = (open: boolean) => {
				document.body.classList.toggle('nav-open', open);
				button.setAttribute('aria-expanded', String(open));
			};
			button.addEventListener('click', () => toggle(!document.body.classList.contains('nav-open')));
			document.querySelector('.scrim')!.addEventListener('click', () => toggle(false));
			document.addEventListener('keydown', (e) => e.key === 'Escape' && toggle(false));
		</script>
	</body>
</html>

<style>
	.app { display: flex; min-height: 100dvh; }
	.main { flex: 1; min-width: 0; display: flex; flex-direction: column; }
	.topbar { display: flex; align-items: center; gap: 12px; min-height: 56px; padding: 12px 24px; }
	.menu { display: none; border: 0; background: none; padding: 6px; border-radius: 8px; cursor: pointer; color: var(--text); }
	.menu:hover { background: var(--hover); }
	main { flex: 1; width: 100%; max-width: 820px; margin: 0 auto; padding: 24px 16px 64px; }
	.scrim { display: none; }

	@media (max-width: 860px) {
		.topbar { padding: 12px 16px; }
		.menu { display: inline-flex; }
		:global(body.nav-open) .scrim { display: block; position: fixed; inset: 0; z-index: 10; background: rgb(0 0 0 / 0.2); }
	}
</style>
