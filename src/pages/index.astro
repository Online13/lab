---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import { getProjects, kinds } from '../lib/projects';

const projects = await getProjects();
const count = (kind: keyof typeof kinds) => projects.filter((p) => p.data.kind === kind).length;
---
<Layout>
	<h1 class="hello">Salut, bienvenue au Lab&nbsp;!</h1>
	<p class="sub">Qu'est-ce qu'on teste aujourd'hui&nbsp;?</p>

	<section class="bento" aria-label="Sections">
		<a href="/web" class="tile wide">
			<div class="art browser" aria-hidden="true">
				<div class="bar"><i></i><i></i><i></i></div>
				<div class="body"><b></b><b></b><b class="short"></b></div>
			</div>
			<h2>{kinds.web.plural} <span class="count">{count('web')}</span></h2>
			<p>{kinds.web.blurb}</p>
		</a>
		<a href="/showcase" class="tile">
			<div class="art slides" aria-hidden="true"><i></i><i></i><i></i></div>
			<h2>{kinds.showcase.plural} <span class="count">{count('showcase')}</span></h2>
			<p>{kinds.showcase.blurb}</p>
		</a>
		<a href="/nouvelle-experience" class="tile">
			<div class="art plus" aria-hidden="true"><span><Icon name="plus" size={26} /></span></div>
			<h2>Nouvelle expérience</h2>
			<p>Une notion à tester ou à apprendre ? C'est parti en deux minutes.</p>
		</a>
		<div class="tile wide note">
			<div class="art waves" aria-hidden="true">{Array.from({ length: 28 }, (_, i) => <i style={`--h:${20 + ((i * 37) % 60)}%`}></i>)}</div>
			<h2>Le principe</h2>
			<p>Une notion à tester ou à apprendre, je l'explore par le code ici, puis je la rends publique. Chaque expérience = un fichier Markdown, plus sa démo si elle tourne dans le navigateur.</p>
		</div>
	</section>

	<section class="recent">
		<div class="announce"><span class="pill green">Nouveau</span> Le Lab est en place. Il ne reste plus qu'à y lancer des expériences.</div>
		<label class="search">
			<Icon name="search" />
			<input id="search" type="search" placeholder="Chercher une notion…" autocomplete="off" />
		</label>
		<div id="results">
			<ProjectGrid projects={projects} empty="Aucune expérience pour l'instant. La première est pour bientôt." />
		</div>
		<p id="no-match" class="no-match" hidden>Aucun résultat.</p>
	</section>
</Layout>

<script>
	const input = document.querySelector<HTMLInputElement>('#search')!;
	const cards = [...document.querySelectorAll<HTMLElement>('#results [data-search]')];
	const noMatch = document.querySelector<HTMLElement>('#no-match')!;
	input.addEventListener('input', () => {
		const q = input.value.trim().toLowerCase();
		let visible = 0;
		for (const card of cards) {
			const match = card.dataset.search!.includes(q);
			card.hidden = !match;
			if (match) visible++;
		}
		noMatch.hidden = visible > 0 || cards.length === 0;
	});
</script>

<style>
	.hello { font-size: clamp(26px, 5vw, 34px); margin-top: 8px; }
	.sub { margin: 2px 0 28px; font-size: clamp(20px, 4vw, 26px); color: var(--muted); letter-spacing: -0.02em; }

	.bento { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
	.tile { display: flex; flex-direction: column; gap: 4px; padding: 10px 10px 14px; background: var(--surface-2); border: 1px solid var(--border); border-radius: var(--radius); transition: box-shadow 0.15s, transform 0.15s; }
	a.tile:hover { box-shadow: var(--shadow); transform: translateY(-1px); }
	.tile.wide { grid-column: span 2; }
	.tile h2 { font-size: 14px; margin: 10px 4px 0; display: flex; align-items: center; gap: 8px; }
	.tile p { margin: 0 4px; color: var(--muted); font-size: 13px; }
	.count { font-size: 12px; font-weight: 500; color: var(--muted); background: var(--hover); border-radius: 999px; padding: 0 8px; }

	.art { height: 120px; border-radius: 10px; background: #efeeea; display: grid; place-items: center; overflow: hidden; }
	.browser { place-items: end center; padding-top: 18px; }
	.browser .bar, .browser .body { width: 72%; background: var(--surface); }
	.browser .bar { display: flex; gap: 5px; padding: 8px 10px; border-radius: 10px 10px 0 0; border: 1px solid var(--border); border-bottom: 0; }
	.browser .bar i { width: 8px; height: 8px; border-radius: 50%; background: var(--border); }
	.browser .bar i:first-child { background: var(--accent); }
	.browser .body { display: grid; gap: 6px; padding: 10px; height: 64px; border: 1px solid var(--border); border-top: 0; box-shadow: var(--shadow); }
	.browser b { height: 8px; border-radius: 4px; background: #eceae6; }
	.browser b.short { width: 55%; background: var(--accent-soft); }
	.slides { position: relative; }
	.slides i { position: absolute; width: 90px; height: 64px; border-radius: 8px; background: var(--surface); border: 1px solid var(--border); box-shadow: var(--shadow); }
	.slides i:nth-child(1) { transform: translate(-34px, 6px) rotate(-8deg); }
	.slides i:nth-child(2) { transform: translate(34px, 6px) rotate(8deg); }
	.slides i:nth-child(3) { background: linear-gradient(135deg, #f7b98c, var(--accent)); }
	.plus span { display: grid; place-items: center; width: 52px; height: 52px; border-radius: 50%; background: var(--text); color: #fff; box-shadow: var(--shadow); }
	.waves { display: flex; align-items: center; justify-content: center; gap: 4px; }
	.waves i { width: 3px; height: var(--h); border-radius: 2px; background: #c9d8f0; }
	.waves i:nth-child(n + 12):nth-child(-n + 16) { background: #5b8fe0; }

	.recent { margin-top: 32px; }
	.announce { display: flex; align-items: center; gap: 10px; padding: 8px 12px 18px; margin-bottom: -12px; border-radius: var(--radius) var(--radius) 0 0; background: var(--green-soft); color: var(--green); font-size: 13px; }
	.announce .pill { background: #c3e6b8; }
	.search { position: relative; display: flex; align-items: center; gap: 10px; padding: 14px 16px; margin-bottom: 20px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); box-shadow: var(--shadow); color: var(--muted); }
	.search input { flex: 1; border: 0; outline: 0; font: inherit; background: none; color: var(--text); }
	.search:focus-within { border-color: var(--accent); }
	.no-match { color: var(--muted); text-align: center; }

	@media (max-width: 640px) {
		.bento { grid-template-columns: 1fr 1fr; }
		.tile.wide { grid-column: span 2; }
	}
	@media (max-width: 420px) {
		.bento { grid-template-columns: 1fr; }
		.tile.wide { grid-column: auto; }
	}
</style>
